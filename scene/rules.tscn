text = "[b]How to Play[/b]"

[node name="Section1Body" type="RichTextLabel" parent="CanvasLayer/ScrollContainer/VBoxContainer" unique_id=1814187331]
custom_minimum_size = Vector2(0, 222)
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.95, 0.87, 0.75, 1)
theme_override_font_sizes/normal_font_size = 22
text = "Steal Poker is a unique variant of traditional poker. Each player is dealt 5 cards. After an ante and one community card, there is a pot-limit betting round. Players may discard and redraw 0-5 cards, followed by another betting round. Then comes the unique twist: everyone reveals their hand and steals one card from the player to their left. A final community card is dealt, leading to showdown."
autowrap_mode = 2

[node name="Section1Heading2" type="RichTextLabel" parent="CanvasLayer/ScrollContainer/VBoxContainer" unique_id=45458632]
custom_minimum_size = Vector2(0, 33)
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.30980393, 0.14509805, 0.03529412, 1)
theme_override_fonts/normal_font = ExtResource("2_brvt")
theme_override_font_sizes/normal_font_size = 34
bbcode_enabled = true
text = "[b]Phases[/b]"

[node name="Section3Body2" type="RichTextLabel" parent="CanvasLayer/ScrollContainer/VBoxContainer" unique_id=119851935]
custom_minimum_size = Vector2(0, 444)
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.95, 0.87, 0.75, 1)
theme_override_font_sizes/normal_font_size = 22
bbcode_enabled = true
text = "-Cards are dealt 
-Mandatory ante of 20 chips
-Betting round (up to 65 chips per bet)
-Flop phase: One community card is dealt to center of table
-Betting round #2
-Discard phase: discard and re-draw part of your hand one time
-Betting round #3
-Steal phase: Take one of the cards from the player on your left. The player on your right will take one of your cards at the same time though!
-Flop phase #2: Another community card is dealt to center of table
-Showdown! Reveal your hands.
-Round end: Player with the best hand wins the pot."
autowrap_mode = 2

