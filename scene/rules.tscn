[node name="Section3Heading" type="RichTextLabel" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.45291597, 0.22542924, 0.07002995, 1)
theme_override_fonts/normal_font = ExtResource("2_brvt")
theme_override_font_sizes/normal_font_size = 34
text = "[b]The Steal[/b]"

[node name="Section3Body" type="RichTextLabel" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.95, 0.87, 0.75, 1)
theme_override_font_sizes/normal_font_size = 22
autowrap_mode = 2
text = "After the second betting round, all players reveal their hands simultaneously. You have 15 seconds to choose one card to take from the player on your left. The stolen card becomes part of your hand. Choose wisely - what you take is as important as what you give away!"

