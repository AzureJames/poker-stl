[node name="Section3Body" type="RichTextLabel" parent="CanvasLayer/ScrollContainer/VBoxContainer" unique_id=1852767209]
custom_minimum_size = Vector2(0, 333)
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.95, 0.87, 0.75, 1)
theme_override_font_sizes/normal_font_size = 22
bbcode_enabled = true
text = "Hands: Remember, a pair or just a high card isn't likely to win. Don't bet everything on those. Also, straights can easily be stolen although you may get lucky and steal them back at the same time. Expect one of your pairs/three of a kind to be stolen towards the end of the round.

Steal: It may be useful to ruin the other player's hand instead of benefitting your own if their cards don't help you much. Keep your mind open to changing your hand strategy during the steal."
autowrap_mode = 2

