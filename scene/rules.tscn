[node name="Section1Heading" type="RichTextLabel" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.45291597, 0.22542924, 0.07002995, 1)
theme_override_fonts/normal_font = ExtResource("2_brvt")
theme_override_font_sizes/normal_font_size = 34
text = "[b]How to Play[/b]"

[node name="Section1Body" type="RichTextLabel" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.95, 0.87, 0.75, 1)
theme_override_font_sizes/normal_font_size = 22
autowrap_mode = 2
text = "Steal Poker is a 4-player variant of traditional poker. Each player is dealt 5 cards. After a 5% ante and one community card, there is a pot-limit betting round (10% of pot max). Players may discard and redraw 0-5 cards, followed by another betting round. Then comes the unique twist: everyone reveals their hand and steals one card from the player to their left. A final community card is dealt, leading to showdown."

[node name="Section2Heading" type="RichTextLabel" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.45291597, 0.22542924, 0.07002995, 1)
theme_override_fonts/normal_font = ExtResource("2_brvt")
theme_override_font_sizes/normal_font_size = 34
text = "[b]Hand Rankings[/b]"

[node name="Section2Body" type="RichTextLabel" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.95, 0.87, 0.75, 1)
theme_override_font_sizes/normal_font_size = 22
autowrap_mode = 2
text = "Standard poker hand rankings apply. See the reference chart below for common hand types from highest to lowest."

